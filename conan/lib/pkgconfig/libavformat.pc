prefix=./builds-arm
exec_prefix=${prefix}
libdir=./builds-arm/lib
includedir=./builds-arm/include

Name: libavformat
Description: FFmpeg container format library
Version: 62.0.102
Requires: 
Requires.private: libavcodec >= 62.3.101, libswresample >= 6.0.100, libavutil >= 60.3.100
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm -lbz2 -lz -lssl -lcrypto
Cflags: -I${includedir}
