prefix=./builds-arm
exec_prefix=${prefix}
libdir=./builds-arm/lib
includedir=./builds-arm/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 11.0.100
Requires: 
Requires.private: libswscale >= 9.0.100, libavformat >= 62.0.102, libavcodec >= 62.3.101, libswresample >= 6.0.100, libavutil >= 60.3.100
Conflicts:
Libs: -L${libdir}  -lavfilter 
Libs.private: -framework OpenGL -framework OpenGL -pthread -lm -ltvai -framework Metal -framework VideoToolbox -lzimg -framework CoreImage -framework AppKit -framework CoreFoundation -framework CoreMedia -framework CoreVideo -framework CoreServices
Cflags: -I${includedir}
